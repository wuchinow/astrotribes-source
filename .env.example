# Names only. Values live in Vercel (Production and Preview) and in your own .env.local, which
# is never committed and never read back by Claude Code. See docs/architecture.md.

# The preview passcode gate and place search (1b). Server only.
PREVIEW_PASSCODE=
GEOAPIFY_API_KEY=

# Supabase (2a). The URL and the publishable key are public by design.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Never prefixed NEXT_PUBLIC_, never sent to the browser (invariant 4).
SUPABASE_SECRET_KEY=
