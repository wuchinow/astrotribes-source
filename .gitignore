# dependencies
/node_modules
/.pnp
.pnp.*

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files: never committed. .env.example holds names only, no values.
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Reference material lives beside the repo at ~/Developer/astrotribes-reference.
# This line stays as a guard in case a copy ever lands inside the repo folder.
/reference/

# Real birth details for the acceptance test live in ~/Developer/astrotribes/private, beside the
# repo. Same guard.
/private/

# Local Claude Code config (launch.json for the preview pane)
/.claude/

# Originals fetched by the art scripts (tarot scans, the subset font source); only their cuts are committed
/.cache/
